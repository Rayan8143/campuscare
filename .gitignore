# --- Repository rules (added for GitHub) ---
# Keep schema/migration/provisioning SQL, but NEVER database dumps or backups.
!migrations/**/*.sql
!stage2_logs/**/*.sql
!stage3_logs/*.sql
!schema.sql
!schema_latest.sql
# Dumps stay ignored even though they end in .sql
backup_before_v2.sql
college_complaints_backup.sql
college_complaints_baseline_*.sql
backups/
# Generated review bundles
*.zip
# One-time activation codes
activation_codes/
*.activation-code

# Hosted (Aiven) credentials and CA certificate: never commit
*.pem
.env.aiven
